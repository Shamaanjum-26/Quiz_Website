<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <linearGradient id="reactBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>
    <linearGradient id="reactCyan" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8" />
      <stop offset="100%" stop-color="#00D8FF" />
    </linearGradient>
    <filter id="reactGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#00D8FF" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- Dark Slate Rounded Plate -->
  <rect x="4" y="4" width="120" height="120" rx="26" fill="url(#reactBg)" stroke="#334155" stroke-width="2" />

  <!-- React & Web Atom -->
  <g filter="url(#reactGlow)">
    <!-- Central Nucleus -->
    <circle cx="64" cy="64" r="9.5" fill="url(#reactCyan)" />

    <!-- Three Orbital Ellipses rotated 0, 60, 120 deg -->
    <ellipse cx="64" cy="64" rx="46" ry="17" fill="none" stroke="url(#reactCyan)" stroke-width="4.2" />
    <ellipse cx="64" cy="64" rx="46" ry="17" fill="none" stroke="url(#reactCyan)" stroke-width="4.2" transform="rotate(60 64 64)" />
    <ellipse cx="64" cy="64" rx="46" ry="17" fill="none" stroke="url(#reactCyan)" stroke-width="4.2" transform="rotate(120 64 64)" />
  </g>
</svg>
