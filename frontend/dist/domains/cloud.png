<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <linearGradient id="cloudBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>
    <linearGradient id="cloudCyan" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8" />
      <stop offset="100%" stop-color="#0284C7" />
    </linearGradient>
    <linearGradient id="dockerBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#60A5FA" />
      <stop offset="100%" stop-color="#2563EB" />
    </linearGradient>
    <filter id="cloudGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0284C7" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Dark Slate Plate -->
  <rect x="4" y="4" width="120" height="120" rx="26" fill="url(#cloudBg)" stroke="#334155" stroke-width="2" />

  <!-- Cloud & DevOps Container Architecture -->
  <g filter="url(#cloudGlow)">
    <!-- Main High-Tech Cloud Outline -->
    <path fill="url(#cloudCyan)" opacity="0.18" d="M42 42a22 22 0 0 1 43.2-5.4A19 19 0 0 1 96 72H34a17 17 0 0 1-2-33.9A21.9 21.9 0 0 1 42 42z" />
    <path fill="none" stroke="url(#cloudCyan)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" d="M42 42a22 22 0 0 1 43.2-5.4A19 19 0 0 1 96 72H34a17 17 0 0 1-2-33.9A21.9 21.9 0 0 1 42 42z" />

    <!-- Docker / Microservices Container Cubes Inside Cloud -->
    <!-- Row 1 -->
    <rect x="52" y="46" width="10" height="9" rx="1.5" fill="#38BDF8" />
    <rect x="65" y="46" width="10" height="9" rx="1.5" fill="#38BDF8" />
    
    <!-- Row 2 -->
    <rect x="39" y="58" width="10" height="9" rx="1.5" fill="#38BDF8" />
    <rect x="52" y="58" width="10" height="9" rx="1.5" fill="#60A5FA" />
    <rect x="65" y="58" width="10" height="9" rx="1.5" fill="#60A5FA" />
    <rect x="78" y="58" width="10" height="9" rx="1.5" fill="#38BDF8" />

    <!-- DevOps Infinite Loop / Deployment Arrows -->
    <g transform="translate(32, 80)">
      <!-- Server Node 1 -->
      <rect x="0" y="8" width="18" height="12" rx="3" fill="#1E293B" stroke="#38BDF8" stroke-width="1.8" />
      <circle cx="5" cy="14" r="1.5" fill="#34D399" />
      <circle cx="10" cy="14" r="1.5" fill="#60A5FA" />

      <!-- Server Node 2 -->
      <rect x="23" y="8" width="18" height="12" rx="3" fill="#1E293B" stroke="#38BDF8" stroke-width="1.8" />
      <circle cx="28" cy="14" r="1.5" fill="#34D399" />
      <circle cx="33" cy="14" r="1.5" fill="#60A5FA" />

      <!-- Server Node 3 -->
      <rect x="46" y="8" width="18" height="12" rx="3" fill="#1E293B" stroke="#38BDF8" stroke-width="1.8" />
      <circle cx="51" cy="14" r="1.5" fill="#34D399" />
      <circle cx="56" cy="14" r="1.5" fill="#60A5FA" />

      <!-- Connecting deployment lines -->
      <line x1="9" y1="0" x2="9" y2="8" stroke="#38BDF8" stroke-width="1.8" stroke-dasharray="2 2" />
      <line x1="32" y1="-8" x2="32" y2="8" stroke="#38BDF8" stroke-width="1.8" />
      <line x1="55" y1="0" x2="55" y2="8" stroke="#38BDF8" stroke-width="1.8" stroke-dasharray="2 2" />
    </g>
  </g>
</svg>
