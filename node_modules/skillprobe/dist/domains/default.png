<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <linearGradient id="defBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>
    <linearGradient id="indigoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#818CF8" />
      <stop offset="100%" stop-color="#6366F1" />
    </linearGradient>
    <filter id="defGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#6366F1" flood-opacity="0.4" />
    </filter>
  </defs>

  <rect x="4" y="4" width="120" height="120" rx="26" fill="url(#defBg)" stroke="#334155" stroke-width="2" />

  <!-- Code Terminal & Diamond -->
  <g filter="url(#defGlow)">
    <!-- Terminal Window -->
    <rect x="28" y="32" width="72" height="54" rx="10" fill="#1E1B4B" stroke="url(#indigoGrad)" stroke-width="2.5" />
    <!-- Header Bar -->
    <line x1="28" y1="46" x2="100" y2="46" stroke="#4338CA" stroke-width="1.5" />
    <circle cx="37" cy="39" r="2.5" fill="#EF4444" />
    <circle cx="45" cy="39" r="2.5" fill="#F59E0B" />
    <circle cx="53" cy="39" r="2.5" fill="#10B981" />

    <!-- Terminal Code Prompt Prompt: >_ -->
    <path d="M42 56 L50 63 L42 70" fill="none" stroke="#A5B4FC" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
    <line x1="56" y1="70" x2="68" y2="70" stroke="#818CF8" stroke-width="2.8" stroke-linecap="round" />

    <!-- Decorative Corner Spark -->
    <circle cx="86" cy="63" r="3" fill="#6366F1" />
  </g>
</svg>
